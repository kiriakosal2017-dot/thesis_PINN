# Template for one vessel. Copy it to ".env.<name>" (not version-controlled), once per vessel,
# and fill in that vessel's values. The names are then listed in ship_registry.py
# (see ship_registry.example.py). All values below are placeholders.

# Operational record: .xlsx or .csv with the reference column names produced by
# prepare_ship_data.py (TIME, Speed-Through-Water, Propeller-Shaft-RPM, Shaft Power_TRQM, ...).
DATA_FILE_PATH=path/to/vessel_data.xlsx

# Speed channel fed to the propeller layer. Use Speed-Over-Ground only if the vessel has no
# usable speed log.
SPEED_COLUMN=Speed-Through-Water

# Propeller particulars, from the propeller drawing.
PROPELLER_DIAMETER=7.00
PROPELLER_BLADES=5
PROPELLER_PITCH_RATIO=0.75
PROPELLER_AREA_RATIO=0.55
